# admin-bff — backend-for-frontend for the admin panel. No database of
# its own: every read/write goes to the owning service's /internal/* API.
# Validated by zod at boot (src/config/env.js).

NODE_ENV=production
PORT=4012
LOG_LEVEL=info

# --- Auth: must match the auth service (this service only verifies tokens) ---
JWT_SECRET=change-me-shared-across-services

# --- Service-to-service: shared key every owning service checks on /internal/* ---
INTERNAL_API_KEY=change-me-shared-with-auth
INTERNAL_HTTP_TIMEOUT_MS=4000
# How long a caller's adminRole/isBlocked (looked up in auth) is trusted.
ADMIN_ROLE_CACHE_MS=30000

# --- CORS (comma-separated allowlist; the gateway is the real edge) ---
CORS_ORIGINS=

# --- Owning services (PRIVATE VPC addresses — never via the gateway, which
# 404s /internal and adds X-Forwarded-* that /internal rejects) ---
AUTH_SERVICE_URL=http://168.144.223.165:4001
IDENTITY_PROFILES_SERVICE_URL=http://165.22.220.237:4002
SERVICE_CATALOGUE_SERVICE_URL=http://165.232.187.231:4004
